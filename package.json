{
  "name": "purepress",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:stockfish": "node scripts/prepare-stockfish.mjs",
    "postinstall": "npm run prepare:stockfish",
    "prebuild": "npm run prepare:stockfish && npm run test:contrast && npm run test:purepress && npm run test:purepress-brand && npm run test:purepress-patch-c && npm run test:purepress-patch-d && npm run test:purepress-patch-e && npm run test:critical && npm run test:pwa",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:core": "tsc -p tsconfig.tests.json && node --test .test-dist/tests/*.test.js",
    "test:identity": "tsc -p tsconfig.tests.json && node --test .test-dist/tests/boardsignal-identity-memory.test.js",
    "test:beta-access": "tsc -p tsconfig.tests.json && node --test .test-dist/tests/boardsignal-beta-access.test.js",
    "test:stockfish": "node scripts/stockfish-smoke.mjs",
    "test:communications": "tsc -p tsconfig.communications.json && node --test .test-dist-communications/tests/boardsignal-communications-onboarding.test.js",
    "test:universe-pulse": "tsc -p tsconfig.universe-pulse.json && node --test tests/boardsignal-universe-pulse.test.cjs",
    "test:critical": "tsc -p tsconfig.critical-regressions.json && node --test .test-dist-critical/tests/boardsignal-identity-memory.test.js .test-dist-critical/tests/boardsignal-beta-access.test.js .test-dist-critical/tests/boardsignal-universe.test.js",
    "test:contrast": "node scripts/check-boardsignal-contrast.mjs",
    "test:ask": "tsc -p tsconfig.ask-board-signal.json && node --test tests/boardsignal-ask-board-signal.test.cjs",
    "test:pwa": "node --test tests/boardsignal-pwa-offline.test.cjs",
    "test:delivery": "node --test tests/boardsignal-delivery-polish.test.cjs",
    "test:activation": "tsc -p tsconfig.activation-bridge.json && node --test tests/boardsignal-activation-bridge.test.cjs",
    "test:legacy-beta-access": "node --test tests/boardsignal-legacy-beta-access-compat.test.cjs",
    "test:preview-return": "tsc -p tsconfig.preview-return.json && node --test tests/boardsignal-preview-return-device-access.test.cjs",
    "test:purepress": "node --test tests/purepress-security-domain-foundation.test.cjs",
    "test:purepress-brand": "node --test tests/purepress-brand-public-website.test.cjs",
    "test:purepress-patch-c": "tsc -p tsconfig.purepress-patch-c.json && node --test tests/purepress-patch-c-validation.test.cjs tests/purepress-patch-c-architecture.test.cjs tests/purepress-patch-c-security-boundary.test.cjs",
    "test:purepress-patch-d": "tsc -p tsconfig.purepress-patch-d.json && node --test tests/purepress-patch-d-validation.test.cjs tests/purepress-patch-d-architecture.test.cjs tests/purepress-patch-d-security.test.cjs",
    "test:purepress-patch-e": "tsc -p tsconfig.purepress-patch-e.json && node --test tests/purepress-patch-e-validation.test.cjs tests/purepress-patch-e-architecture.test.cjs tests/purepress-patch-e-security.test.cjs tests/purepress-patch-e-pdf.test.cjs tests/purepress-patch-e-owner-entry.test.cjs"
  },
  "dependencies": {
    "@uploadthing/react": "^7.3.3",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "chess.js": "^1.4.0",
    "firebase": "^11.9.0",
    "firebase-admin": "^13.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.513.0",
    "next": "^15.5.15",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "stockfish": "18.0.8",
    "uploadthing": "^7.7.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "postcss": "^8.5.4",
    "tailwindcss": "^4.1.8",
    "typescript": "^5"
  }
}
