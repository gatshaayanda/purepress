rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isUnsignedClient() {
      return request.auth == null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isBoardSignalAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isPurePressAdmin() {
      return request.auth != null
        && (request.auth.token.purepress_admin == true || request.auth.token.admin == true);
    }

    function isOptionalString(field) {
      return !(field in request.resource.data) || request.resource.data[field] is string;
    }

    function isOptionalBool(field) {
      return !(field in request.resource.data) || request.resource.data[field] is bool;
    }

    function isOptionalList(field) {
      return !(field in request.resource.data) || request.resource.data[field] is list;
    }

    function isOptionalTimestamp(field) {
      return !(field in request.resource.data) || request.resource.data[field] is timestamp;
    }

    function isNumberValue(value) {
      return value is int || value is float;
    }

    function isOptionalNumber(field) {
      return !(field in request.resource.data) || isNumberValue(request.resource.data[field]);
    }

    function isValidEmail(value) {
      return value is string
        && value.size() >= 3
        && value.size() <= 254
        && value.matches('^[^@]+@[^@]+[.][^@]+$');
    }

    function isReasonableText(value, maxSize) {
      return value is string && value.size() > 0 && value.size() <= maxSize;
    }

    /* ========================================================
       INTENTIONALLY PUBLIC SITE CONTENT
       Reads are public; writes require authenticated admin claim.
       ======================================================== */
    match /blogs/{blogId} {
      allow read: if true;
      allow create, update, delete: if isPurePressAdmin();
    }

    match /highlights/{highlightId} {
      allow read: if true;
      allow create, update, delete: if isPurePressAdmin();
    }

    match /service_packages/{packageId} {
      allow read: if true;
      allow create, update, delete: if isPurePressAdmin();
    }

    match /site_content/{docId} {
      allow read: if true;
      allow create, update, delete: if isPurePressAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isPurePressAdmin();
    }

    match /insurance_products/{productId} {
      allow read: if true;
      allow create, update, delete: if isPurePressAdmin();
    }

    /* ========================================================
       LEGACY PUBLIC CONTACT INTAKE
       Public can submit narrowly-shaped records, never read them.
       ======================================================== */
    match /inquiries/{inquiryId} {
      allow create: if isUnsignedClient()
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'business', 'business_name', 'company',
          'country', 'region', 'role', 'message', 'project_type', 'budget',
          'timeline', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidEmail(request.resource.data.email)
        && isReasonableText(request.resource.data.message, 5000)
        && isOptionalString('name')
        && isOptionalString('phone')
        && isOptionalString('business')
        && isOptionalString('business_name')
        && isOptionalString('company')
        && isOptionalString('country')
        && isOptionalString('region')
        && isOptionalString('role')
        && isOptionalString('project_type')
        && isOptionalString('budget')
        && isOptionalString('timeline')
        && isOptionalString('status')
        && isOptionalTimestamp('createdAt')
        && isOptionalTimestamp('updatedAt');

      allow read, update, delete: if isPurePressAdmin();
    }

    match /contact_messages/{messageId} {
      allow create: if isUnsignedClient()
        && request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'business', 'message', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidEmail(request.resource.data.email)
        && isReasonableText(request.resource.data.message, 5000)
        && isOptionalString('name')
        && isOptionalString('phone')
        && isOptionalString('business')
        && isOptionalString('status')
        && isOptionalTimestamp('createdAt')
        && isOptionalTimestamp('updatedAt');

      allow read, update, delete: if isPurePressAdmin();
    }

    /* ========================================================
       INTERNAL CRM / ADMINHUB RECORDS
       No anonymous reads or writes.
       ======================================================== */
    match /partners/{partnerId} {
      allow read, create, update, delete: if isPurePressAdmin();
    }

    match /agents/{agentId} {
      allow read, create, update, delete: if isPurePressAdmin();
    }

    match /leads/{leadId} {
      allow read, create, update, delete: if isPurePressAdmin();
    }

    match /opportunities/{opportunityId} {
      allow read, create, update, delete: if isPurePressAdmin();
    }

    /* ========================================================
       PUREPRESS QUOTE INTAKE
       Public create is intentionally narrow. Raw requests are admin-only.
       ======================================================== */
    match /purepressQuoteRequests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'companyName', 'garmentType', 'quantity',
          'requestDetails', 'artworkNotes', 'deadlineNotes', 'source', 'status', 'createdAt'
        ])
        && isReasonableText(request.resource.data.name, 120)
        && isValidEmail(request.resource.data.email)
        && isReasonableText(request.resource.data.requestDetails, 5000)
        && request.resource.data.status == 'new_request'
        && request.resource.data.source == 'public'
        && request.resource.data.createdAt is timestamp
        && isOptionalString('phone')
        && isOptionalString('companyName')
        && isOptionalString('garmentType')
        && isOptionalNumber('quantity')
        && isOptionalString('artworkNotes')
        && isOptionalString('deadlineNotes');

      allow read, update, delete: if isPurePressAdmin();
    }

    /* ========================================================
       PROJECTS / EMBROIDERY JOB COMPATIBILITY ROOT
       Raw inherited project records can contain internal notes, so they are
       never customer-readable. Customers consume safe projections below.
       ======================================================== */
    match /projects/{projectId} {
      allow read, create, update, delete: if isPurePressAdmin();

      match /messages/{messageId} {
        allow read, create, update, delete: if isPurePressAdmin();
      }
    }

    /* ========================================================
       PUREPRESS CUSTOMER AUTHORIZATION + SAFE PROJECTIONS
       Server/Admin SDK writes these records. Customers can only read their UID.
       ======================================================== */
    match /purepressCustomerProfiles/{userId} {
      allow read: if isOwner(userId)
        && resource.data.keys().hasOnly([
          'uid', 'customerId', 'email', 'displayName', 'phone', 'companyName', 'createdAt', 'updatedAt'
        ])
        && resource.data.uid == userId;
      allow write: if false;
    }

    match /purepressJobAccess/{userId}/jobs/{jobId} {
      allow read: if isOwner(userId)
        && resource.data.customerUid == userId
        && resource.data.jobId == jobId;
      allow write: if false;
    }

    match /purepressOrderViews/{viewId} {
      allow read: if request.auth != null
        && resource.data.customerUid == request.auth.uid
        && resource.data.keys().hasOnly([
          'orderId', 'projectId', 'customerId', 'customerUid', 'status', 'title',
          'summary', 'quantity', 'nextStep', 'customerNotes', 'files', 'proof',
          'updates', 'createdAt', 'updatedAt'
        ]);
      allow write: if false;
    }

    match /purepressOrderMessages/{messageId} {
      allow read: if isPurePressAdmin()
        || (request.auth != null
          && resource.data.customerUid == request.auth.uid
          && resource.data.visibility == 'customer'
          && exists(/databases/$(database)/documents/purepressJobAccess/$(request.auth.uid)/jobs/$(resource.data.jobId)));

      allow create: if isPurePressAdmin()
        || (request.auth != null
          && request.resource.data.keys().hasOnly([
            'jobId', 'orderId', 'customerUid', 'senderType', 'senderUid', 'visibility',
            'text', 'attachmentFileIds', 'createdAt'
          ])
          && request.resource.data.customerUid == request.auth.uid
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderType == 'customer'
          && request.resource.data.visibility == 'customer'
          && request.resource.data.jobId is string
          && request.resource.data.orderId is string
          && request.resource.data.createdAt is timestamp
          && isOptionalString('text')
          && isOptionalList('attachmentFileIds')
          && (('text' in request.resource.data && request.resource.data.text.size() > 0)
            || ('attachmentFileIds' in request.resource.data && request.resource.data.attachmentFileIds.size() > 0))
          && exists(/databases/$(database)/documents/purepressJobAccess/$(request.auth.uid)/jobs/$(request.resource.data.jobId)));

      allow update, delete: if isPurePressAdmin();
    }

    /* ========================================================
       PUREPRESS PUBLIC WORK MEDIA
       Uploads/gallery candidates are private until a separate deliberate
       publication record is both published and marked safePublic.
       ======================================================== */
    match /purepressPublicWorkMedia/{mediaId} {
      allow read: if resource.data.published == true && resource.data.safePublic == true;
      allow create, update, delete: if isPurePressAdmin();
    }

    /* ========================================================
       BOARDSIGNAL — IDENTITY, MEMORY & BETA ACCESS
       Preserved for inherited code during the PurePress transition.
       ======================================================== */
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      match /desks/{deskKey} {
        allow read, create, update, delete: if isOwner(userId);

        match /evidence/{positionId} {
          allow read, create, update, delete: if isOwner(userId);
        }
      }

      match /inbox/{messageId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /conversations/{threadId} {
        allow read: if isOwner(userId);
        allow write: if false;

        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow write: if false;
        }
      }

      match /pushTokens/{tokenId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /automationEvents/{eventId} {
        allow read, write: if false;
      }

      match /pulse/{pulseId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /social/{otherPlayerId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /guide/{guideId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /guideFeedback/{feedbackId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    match /publicPlayers/{chessPlayerId} {
      allow read: if true;
      allow write: if isBoardSignalAdmin();
    }

    match /publicCoverage/{coverageId} {
      allow read: if true;
      allow write: if isBoardSignalAdmin();
    }

    match /publicUniverseEvents/{eventId} {
      allow read: if resource.data.safePublic == true;
      allow write: if isBoardSignalAdmin();
    }

    match /publicShareMoments/{momentId} {
      allow read: if resource.data.safePublic == true;
      allow write: if isBoardSignalAdmin();
    }

    match /shareAttribution/{eventId} {
      allow read, write: if false;
    }

    match /socialRelationships/{relationshipId} {
      allow read, write: if false;
    }

    match /socialBlocks/{blockId} {
      allow read, write: if false;
    }

    match /socialRequestRateLimits/{limitId} {
      allow read, write: if false;
    }

    match /guideAnalytics/{period} {
      allow read, write: if false;
    }

    match /betaRequests/{requestId} {
      allow read, write: if false;
    }

    match /betaRequestRateLimits/{limitId} {
      allow read, write: if false;
    }

    match /communications/{campaignId} {
      allow read, write: if false;
    }

    match /exceptions/{exceptionId} {
      allow read, write: if false;
    }

    match /chessPlayerAccounts/{playerId} {
      allow read, write: if false;
    }

    match /playerIdentityAliases/{alias} {
      allow read, write: if false;
    }

    match /authCompletionTickets/{ticketId} {
      allow read, write: if false;
    }

    match /betaAccess/{playerId} {
      allow read, write: if false;
    }

    /* ========================================================
       DENY EVERYTHING ELSE
       ======================================================== */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
